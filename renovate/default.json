{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests"
  ],
  "platformAutomerge": true,
  "labels": ["auto-deps"],
  "packageRules": [
    {
      "matchUpdateTypes": ["digest", "pin", "pinDigest", "patch", "minor"],
      "automerge": true
    },
    {
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["auto-deps", "major"]
    },
    {
      "matchDatasources": ["npm", "packagist"],
      "minimumReleaseAge": "3 days"
    },
    {
      "matchDepNames": ["mysql", "haproxy"],
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["pin", "pinDigest", "replacement", "bump", "rollback", "patch", "minor", "major"],
      "enabled": false
    },
    {
      "matchDepNames": ["citadel/php-apache"],
      "enabled": false
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["quay.io/buildah/stable"],
      "versioning": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?<compatibility>-immutable)$"
    },
    {
      "matchDatasources": ["npm"],
      "matchPackageNames": ["axe-core", "@axe-core/playwright"],
      "matchFileNames": ["templates/a11y/template.yml", "contract/inputs.json"],
      "groupName": "axe-core for the a11y component"
    },
    {
      "matchPackageNames": ["waynestate/*", "@waynestate/*"],
      "minimumReleaseAge": "0"
    },
    {
      "matchPackageNames": ["waynestate/*", "@waynestate/*"],
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true
    },
    {
      "matchFileNames": ["templates/**", "contract/**", ".gitlab-ci.yml"],
      "automerge": false,
      "platformAutomerge": false,
      "labels": ["auto-deps", "needs-review"]
    },
    {
      "matchManagers": ["gitlabci", "gitlabci-include"],
      "matchDepTypes": ["repository"],
      "automerge": false,
      "platformAutomerge": false,
      "labels": ["auto-deps", "needs-review"]
    },
    {
      "matchFileNames": [
        "**/docker-compose.squire.yml",
        "**/.squire/**",
        "!/^templates\\/(common|vue|raw|laravel|static)\\//"
      ],
      "enabled": false
    },
    {
      "matchDepNames": ["waynestate/squire"],
      "matchManagers": ["custom.regex"],
      "automerge": false,
      "platformAutomerge": false,
      "labels": ["auto-deps", "squire-kit", "needs-review"],
      "postUpgradeTasks": {
        "commands": [
          "composer create-project --no-dev --no-interaction --no-progress --no-scripts waynestate/squire /tmp/renovate-squire/{{{replace '[^A-Za-z0-9_-]' '-' repository}}}-{{{replace '[^A-Za-z0-9_-]' '-' packageFile}}} {{{newVersion}}}",
          "php /tmp/renovate-squire/{{{replace '[^A-Za-z0-9_-]' '-' repository}}}-{{{replace '[^A-Za-z0-9_-]' '-' packageFile}}}/bin/squire update --path={{{packageFileDir}}}"
        ],
        "installTools": {
          "php": {},
          "composer": {}
        },
        "executionMode": "update"
      },
      "prBodyNotes": [
        "A new Squire is out. On a runner that allows the Squire kit commands (the renovate component's `squire_kit_tasks` input), Renovate already ran `squire update` on this kit, so this branch carries the refreshed files. If the merge request shows an artifact error instead, run `vendor/bin/squire update --path=<kit folder>` yourself, review the diff and commit it to this branch; a release that adds a kit file also needs `vendor/bin/squire init --path=<kit folder>`. The `squire-kit` CI job fails until the kit matches the recorded version."
      ]
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["on monday"],
    "automerge": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["**/docker-compose*.yml"],
      "matchStrings": [
        "\\$\\{[A-Za-z_][A-Za-z0-9_]*:-(?<depName>[a-z0-9][a-z0-9._/-]*):(?<currentValue>[^:@{}\\n]+)@(?<currentDigest>sha256:[a-f0-9]{64})\\}"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["templates/**/template.yml"],
      "matchStrings": [
        "default:\\s+(?<depName>[a-z0-9][a-z0-9._/-]*):(?<currentValue>[^:@{}\\n]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["contract/inputs.json"],
      "matchStrings": [
        "\"default\"\\s*:\\s*\"(?<depName>[a-z0-9][a-z0-9._/-]*):(?<currentValue>[^:@{}\\n]+)@(?<currentDigest>sha256:[a-f0-9]{64})\""
      ],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["templates/a11y/template.yml", "contract/inputs.json"],
      "matchStrings": [
        "axe_core_version:\\s*\\n\\s*type: string\\s*\\n\\s*default: \"(?<currentValue>[0-9][^\"]*)\"",
        "\"name\": \"axe_core_version\", \"type\": \"string\", \"default\": \"(?<currentValue>[0-9][^\"]*)\""
      ],
      "depNameTemplate": "axe-core",
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["templates/a11y/template.yml", "contract/inputs.json"],
      "matchStrings": [
        "axe_playwright_version:\\s*\\n\\s*type: string\\s*\\n\\s*default: \"(?<currentValue>[0-9][^\"]*)\"",
        "\"name\": \"axe_playwright_version\", \"type\": \"string\", \"default\": \"(?<currentValue>[0-9][^\"]*)\""
      ],
      "depNameTemplate": "@axe-core/playwright",
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)\\.squire\\.json$/"],
      "matchStrings": [
        "\"squire\"\\s*:\\s*\"Written by SQUIRE[^\\n]*\\n\\s*\"version\"\\s*:\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "waynestate/squire",
      "datasourceTemplate": "packagist"
    }
  ]
}

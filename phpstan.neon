includes:
    - vendor/waynestate/pinstripe/phpstan/raw.neon

parameters:
    paths:
        - src
        - bin
        - tests
    excludePaths:
        - tests/fixture-app
        - tests/php-test-fails
        - tests/phpstan-fails
        - tests/pint-fails
        - bin/docs-site.php
    phpVersion:
        min: 80300
        max: 80599

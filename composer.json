{
    "name": "waynestate/preflight",
    "description": "GitLab CI/CD components and a reusable GitHub Actions workflow for WSU PHP packages.",
    "type": "project",
    "homepage": "https://preflight.apps.wayne.edu/",
    "support": {
        "source": "https://github.com/waynestate/preflight"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Wayne State University, Enterprise Applications"
        }
    ],
    "require": {
        "php": "^8.3",
        "symfony/yaml": "^7.0"
    },
    "require-dev": {
        "laravel/pint": "^1.32",
        "phpstan/phpstan": "^2.3"
    },
    "autoload": {
        "psr-4": {
            "WayneState\\Preflight\\": "src/"
        }
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "sort-packages": true
    },
    "scripts": {
        "ci": [
            "php bin/lint-templates",
            "php bin/lint-templates --test",
            "@lint",
            "@analyse"
        ],
        "lint": "pint --test",
        "fix": "pint",
        "analyse": "phpstan analyse --memory-limit=1G"
    }
}

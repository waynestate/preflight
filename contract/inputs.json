{
  "note": "The inputs contract for the PREFLIGHT components. Inside a major version, an input keeps its name, type and default, and a job keeps its name (BEST_PRACTICES.md 1.4). tests/check-contract.sh and tests/check-contract.ps1 compare templates/*/template.yml against this file on every pipeline. Only name, type and default are compared, so a template may add fields such as regex: without breaking the contract.",
  "components": {
    "proctor": {
      "inputs": [
        { "name": "stage", "type": "string", "default": "test" },
        { "name": "job_name", "type": "string", "default": "proctor", "regex": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$" },
        { "name": "image", "type": "string", "default": "php:8.4-cli-trixie@sha256:9cf851bc2c1b37c3e59dfd677a3c3e56d485af5a47c93f629424bb039eafcb69" },
        { "name": "composer_version", "type": "string", "default": "2.10.3" },
        { "name": "allow_failure", "type": "boolean", "default": false },
        { "name": "proctor_command", "type": "string", "default": "vendor/bin/proctor check --format=codequality" },
        { "name": "working_dir", "type": "string", "default": ".", "regex": "^(\\.|[A-Za-z0-9_-][A-Za-z0-9._/-]*)$" }
      ],
      "jobs": ["proctor"]
    },
    "php-test": {
      "inputs": [
        { "name": "stage", "type": "string", "default": "test" },
        { "name": "job_name", "type": "string", "default": "php-test", "regex": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$" },
        { "name": "image", "type": "string", "default": "php:${PHP_VERSION}-cli-trixie" },
        { "name": "php_versions", "type": "array", "default": ["8.3", "8.4", "8.5"] },
        { "name": "composer_version", "type": "string", "default": "2.10.3" },
        { "name": "test_command", "type": "string", "default": "vendor/bin/phpunit" },
        { "name": "working_dir", "type": "string", "default": ".", "regex": "^(\\.|[A-Za-z0-9_-][A-Za-z0-9._/-]*)$" }
      ],
      "jobs": ["php-test"]
    },
    "composer-audit": {
      "inputs": [
        { "name": "stage", "type": "string", "default": "test" },
        { "name": "job_name", "type": "string", "default": "composer-audit", "regex": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$" },
        { "name": "image", "type": "string", "default": "composer:2@sha256:b6dcd72ca98fa19d0e5b8476de179859704891fad06dd9e0b96833d4c430a5fc" },
        { "name": "working_dir", "type": "string", "default": ".", "regex": "^(\\.|[A-Za-z0-9_-][A-Za-z0-9._/-]*)$" },
        { "name": "abandoned", "type": "string", "default": "fail", "regex": "^(fail|report|ignore)$" }
      ],
      "jobs": ["composer-audit"]
    },
    "sbom": {
      "inputs": [
        { "name": "stage", "type": "string", "default": "test" },
        { "name": "job_name", "type": "string", "default": "sbom", "regex": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$" },
        { "name": "image", "type": "string", "default": "composer:2.10.3@sha256:b6dcd72ca98fa19d0e5b8476de179859704891fad06dd9e0b96833d4c430a5fc" },
        { "name": "omit_dev", "type": "boolean", "default": true },
        { "name": "output", "type": "string", "default": "sbom.cdx.json", "regex": "^[A-Za-z0-9_-][A-Za-z0-9._/-]*$" }
      ],
      "jobs": ["sbom"]
    },
    "pint": {
      "inputs": [
        { "name": "stage", "type": "string", "default": "test" },
        { "name": "job_name", "type": "string", "default": "pint", "regex": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$" },
        { "name": "image", "type": "string", "default": "composer:2.10.3@sha256:b6dcd72ca98fa19d0e5b8476de179859704891fad06dd9e0b96833d4c430a5fc" },
        { "name": "config", "type": "string", "default": "pint.json", "regex": "^[A-Za-z0-9_-][A-Za-z0-9._/-]*$" },
        { "name": "working_dir", "type": "string", "default": ".", "regex": "^(\\.|[A-Za-z0-9_-][A-Za-z0-9._/-]*)$" }
      ],
      "jobs": ["pint"]
    },
    "phpstan": {
      "inputs": [
        { "name": "stage", "type": "string", "default": "test" },
        { "name": "job_name", "type": "string", "default": "phpstan", "regex": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$" },
        { "name": "image", "type": "string", "default": "composer:2.10.3@sha256:b6dcd72ca98fa19d0e5b8476de179859704891fad06dd9e0b96833d4c430a5fc" },
        { "name": "config", "type": "string", "default": "phpstan.neon", "regex": "^[A-Za-z0-9_-][A-Za-z0-9._/-]*$" },
        { "name": "memory_limit", "type": "string", "default": "1G", "regex": "^(-1|[0-9]+[KkMmGg]?)$" },
        { "name": "working_dir", "type": "string", "default": ".", "regex": "^(\\.|[A-Za-z0-9_-][A-Za-z0-9._/-]*)$" }
      ],
      "jobs": ["phpstan"]
    },
    "eslint": {
      "inputs": [
        { "name": "stage", "type": "string", "default": "test" },
        { "name": "job_name", "type": "string", "default": "eslint", "regex": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$" },
        { "name": "image", "type": "string", "default": "node:22.13-alpine@sha256:e2b39f7b64281324929257d0f8004fb6cb4bf0fdfb9aa8cedb235a766aec31da" },
        { "name": "working_dir", "type": "string", "default": ".", "regex": "^(\\.|[A-Za-z0-9_-][A-Za-z0-9._/-]*)$" },
        { "name": "eslint_args", "type": "string", "default": "." },
        { "name": "prettier", "type": "boolean", "default": true }
      ],
      "jobs": ["eslint"]
    },
    "secret-detection": {
      "inputs": [
        { "name": "stage", "type": "string", "default": "test" },
        { "name": "job_name", "type": "string", "default": "secret-detection", "regex": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$" },
        { "name": "image", "type": "string", "default": "zricethezav/gitleaks:v8.30.1@sha256:c00b6bd0aeb3071cbcb79009cb16a60dd9e0a7c60e2be9ab65d25e6bc8abbb7f" },
        { "name": "config_path", "type": "string", "default": "", "regex": "^([A-Za-z0-9_-][A-Za-z0-9._/-]*)?$" },
        { "name": "allow_failure", "type": "boolean", "default": false }
      ],
      "jobs": ["secret-detection"]
    },
    "package-publish": {
      "inputs": [
        { "name": "stage", "type": "string", "default": "deploy" },
        { "name": "job_name", "type": "string", "default": "package-publish", "regex": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$" },
        { "name": "image", "type": "string", "default": "composer:2.10.3@sha256:b6dcd72ca98fa19d0e5b8476de179859704891fad06dd9e0b96833d4c430a5fc" },
        { "name": "group_id", "type": "string" },
        { "name": "read_token_variable", "type": "string", "default": "PACKAGE_READ_TOKEN" }
      ],
      "jobs": ["package-publish"]
    },
    "renovate": {
      "inputs": [
        { "name": "job_name", "type": "string", "default": "renovate", "regex": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$" },
        { "name": "image", "type": "string", "default": "renovate/renovate:44.192.2@sha256:37960a62ba1faa9079a7c4eead9b3f4470748a64ecd207e06c09fd8858673e17" },
        { "name": "autodiscover_filter", "type": "string", "default": "$CI_PROJECT_NAMESPACE/*" },
        { "name": "dry_run", "type": "string", "default": "null" },
        { "name": "git_author", "type": "string" },
        { "name": "squire_kit_tasks", "type": "boolean", "default": false }
      ],
      "jobs": ["renovate"]
    },
    "portability": {
      "inputs": [
        { "name": "stage", "type": "string", "default": "test" },
        { "name": "image", "type": "string", "default": "$CI_REGISTRY_IMAGE/portability:$CI_COMMIT_SHORT_SHA" },
        { "name": "buildah_image", "type": "string", "default": "quay.io/buildah/stable:v1.43.5-immutable@sha256:7c2b605262748ace2c5c57c5550942d0adad57aec82ede3070927722306c0ffb" },
        { "name": "dockerfile", "type": "string", "default": "Dockerfile" },
        { "name": "context", "type": "string", "default": "." },
        { "name": "app_root", "type": "string", "default": "/app" },
        { "name": "writable_paths", "type": "array", "default": ["storage", "bootstrap/cache"] },
        { "name": "port", "type": "number", "default": 8080 },
        { "name": "health_path", "type": "string", "default": "/up" },
        { "name": "uid", "type": "number", "default": 100123 },
        { "name": "start_command", "type": "string" },
        { "name": "boot_timeout", "type": "number", "default": 60 }
      ],
      "jobs": ["portability-build", "portability-run"]
    },
    "a11y": {
      "inputs": [
        { "name": "stage", "type": "string", "default": "test" },
        { "name": "job_name", "type": "string", "default": "a11y", "regex": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$" },
        { "name": "image", "type": "string", "default": "mcr.microsoft.com/playwright:v1.65.0-noble@sha256:6e3fb709361521eb27161606e6da6d2674e5e89fa16516cb37d6fdd91372273d" },
        { "name": "allow_failure", "type": "boolean", "default": false },
        { "name": "site_dir", "type": "string", "default": "site", "regex": "^(\\.|[A-Za-z0-9_-][A-Za-z0-9._/-]*)$" },
        { "name": "pages", "type": "array", "default": ["**/*.html"] },
        { "name": "base_url", "type": "string", "default": "", "regex": "^(|https?://\\S+|\\$\\{?[A-Za-z_][A-Za-z0-9_]*\\}?\\S*)$" },
        { "name": "wcag_tags", "type": "array", "default": ["wcag2a", "wcag2aa", "wcag21a", "wcag21aa"] },
        { "name": "color_schemes", "type": "array", "default": ["light", "dark"] },
        { "name": "widths", "type": "array", "default": [320, 1280] },
        { "name": "playwright_version", "type": "string", "default": "", "regex": "^([0-9]+\\.[0-9]+\\.[0-9]+)?$" },
        { "name": "axe_core_version", "type": "string", "default": "4.14.0", "regex": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        { "name": "axe_playwright_version", "type": "string", "default": "4.14.0", "regex": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      ],
      "jobs": ["a11y"]
    },
    "squire-kit": {
      "inputs": [
        { "name": "stage", "type": "string", "default": "test" },
        { "name": "job_name", "type": "string", "default": "squire-kit", "regex": "^[A-Za-z0-9_][A-Za-z0-9_.-]*$" },
        { "name": "image", "type": "string", "default": "composer:2.10.3@sha256:b6dcd72ca98fa19d0e5b8476de179859704891fad06dd9e0b96833d4c430a5fc" },
        { "name": "working_dir", "type": "string", "default": ".", "regex": "^(\\.|[A-Za-z0-9_-][A-Za-z0-9._/-]*)$" },
        { "name": "squire_version", "type": "string", "default": "", "regex": "^([0-9]+\\.[0-9]+\\.[0-9]+)?$" },
        { "name": "allow_failure", "type": "boolean", "default": false }
      ],
      "jobs": ["squire-kit"]
    }
  }
}
